@model AMS.Application.DTOs.DashboardDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="row">

    <div class="col-md-3">

        <div class="card shadow-sm border-0 bg-primary text-white">

            <div class="card-body">

                <h6>Total Applications</h6>

                <h2>@Model.TotalApplications</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow-sm border-0 bg-warning text-dark">

            <div class="card-body">

                <h6>Pending</h6>

                <h2>@Model.PendingApplications</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow-sm border-0 bg-success text-white">

            <div class="card-body">

                <h6>Approved</h6>

                <h2>@Model.ApprovedApplications</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow-sm border-0 bg-danger text-white">

            <div class="card-body">

                <h6>Rejected</h6>

                <h2>@Model.RejectedApplications</h2>

            </div>

        </div>

    </div>

</div>

<hr />

<div class="row mt-4">

    <div class="col-md-8">

        <div class="card shadow-sm">

            <div class="card-header">
                Application Status Chart
            </div>

            <div class="card-body">

                <canvas id="applicationChart"
                        height="120"></canvas>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const ctx =
            document.getElementById('applicationChart');

        new Chart(ctx, {

            type: 'bar',

            data: {

                labels: [
                    'Pending',
                    'Approved',
                    'Rejected'
                ],

                datasets: [{

                    label: 'Applications',

                    data: [
                        @Model.PendingApplications,
                        @Model.ApprovedApplications,
                        @Model.RejectedApplications
                    ],

                    borderWidth: 1
                }]
            }
        });

    </script>

}