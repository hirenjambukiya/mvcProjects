@model DashboardViewModel  
<!DOCTYPE html>  
<html>  
<head>  
    <meta charset="utf-8" />  
    <title>Database Dashboard</title>  
    <meta name="viewport" content="width=device-width, initial-scale=1">  

    <!-- ✅ Bootstrap 5 -->  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />  

    <!-- ✅ DataTables CSS (include only once) -->  
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />  

    <style>  
        body {  
            padding-top: 30px;  
        }  
        #dataTable_wrapper {  
            margin-top: 20px;  
        }  
    </style>  
</head>  
<body>  
    <div class="container">  
        <h2 class="mb-4">Database Dashboard</h2>  

        @if (!string.IsNullOrEmpty(Model.AlertMessage))  
        {  
            <div class="alert alert-success fade show" id="alertBox">@Model.AlertMessage</div>  
        }  

        @if (ViewBag.Error != null)  
        {  
            <div class="alert alert-danger">@ViewBag.Error</div>  
        }  

        <form method="post" asp-controller="Dashboard" asp-action="Search">  
            <div class="row mb-3">  
                <div class="col-md-5">  
                    <label class="form-label">Select Database</label>  
                    <select name="SelectedDatabase" class="form-select" onchange="this.form.submit()" required>  
                        <option value="">-- Select --</option>  
                        @foreach (var db in Model.Databases)  
                        {  
                            <option value="@db" selected="@(db == Model.SelectedDatabase)">@db</option>  
                        }  
                    </select>  
                </div>  

                <div class="col-md-5">  
                    <label class="form-label">Select Table</label>  
                    <select name="SelectedTable" class="form-select" required>  
                        <option value="">-- Select --</option>  
                        @foreach (var tbl in Model.Tables)  
                        {  
                            <option value="@tbl" selected="@(tbl == Model.SelectedTable)">@tbl</option>  
                        }  
                    </select>  
                </div>  

                <div class="col-md-2 d-flex align-items-end">  
                    <button type="submit" class="btn btn-success w-100">Search</button>  
                </div>  
            </div>  
        </form>  

        @if (Model.TableData != null && Model.TableData.Rows.Count > 0)  
        {  
            <div class="table-responsive">  
                <table class="table table-bordered table-hover" id="dataTable">  
                    <thead class="table-dark">  
                        <tr>  
                            @foreach (System.Data.DataColumn col in Model.TableData.Columns)  
                            {  
                                <th>@col.ColumnName</th>  
                            }  
                        </tr>  
                    </thead>  
                    <tbody>  
                        @foreach (System.Data.DataRow row in Model.TableData.Rows)  
                        {  
                            <tr>  
                                @foreach (var item in row.ItemArray)  
                                {  
                                    <td>@item?.ToString()</td>  
                                }  
                            </tr>  
                        }  
                    </tbody>  
                </table>  
            </div>  
        }  
    </div>  

    <!-- ✅ Scripts -->  
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>  
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>  

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>  
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>  
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>  

    <script>  
        $(document).ready(function () {  
            $('#dataTable').DataTable({  
                paging: true,  
                searching: true,  
                pageLength: 10,  
                lengthMenu: [5, 10, 25, 50, 100],  
                autoWidth: false,  
                scrollCollapse: true  
            });  

            setTimeout(function () {  
                $('#alertBox').fadeOut('slow');  
            }, 4000);  
        });  
    </script>  
</body>  
</html>
