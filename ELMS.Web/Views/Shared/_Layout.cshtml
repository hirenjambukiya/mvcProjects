<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"]
    </title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/toastr/toastr.min.css" />
    <style>
        nav{
            background-color: #808080;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container-fluid">
            <a class="navbar-brand" asp-action="Dashboard" asp-controller="Employee">ELMS</a>
            @{
                if (User.IsInRole("Employee"))
                {
                  <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" asp-action="Dashboard" asp-controller="Employee">Dashboard</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Request
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                                <li><a class="dropdown-item" asp-action="LeaveHistory" asp-controller="Leave">Leave</a></li>
                            </ul>
                        </li>
                    </ul>
                  </div>
                    <ul class="navbar-nav">
                        <li><a class="dropdown-item" asp-action="UpdateProfile" asp-controller="Login">Manage Profile</a></li>
                        <li><a class="dropdown-item" asp-action="LogOut" asp-controller="Login">Logout</a></li>
                    </ul>
                }
                else if (User.IsInRole("HR"))
                {
                  <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" asp-action="Dashboard" asp-controller="HR">Dashboard</a>
                        </li>
                    </ul>
                  </div>
                    <ul class="navbar-nav">
                        <li><a class="dropdown-item" asp-action="UpdateProfile" asp-controller="Login">Manage Profile</a></li>
                        <li><a class="dropdown-item" asp-action="LogOut" asp-controller="Login">Logout</a></li>
                    </ul>
                }
            }
            
        </div>
    </nav>
    <div class="container mt-5">
        @RenderBody()
    </div>
    <!-- Section: Design Block -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toastr/toastr.min.js"></script>
    <script src="~/js/toastr/tostermodify.js"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/js/leave.js"></script>
    <script src="~/js/HR.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
