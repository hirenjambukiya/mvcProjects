@model LeaveForm;
@{
	ViewData["Title"] = "Leave History";
}

<div class="container">
	<!-- Page Header -->
	<div class="mb-4">
		<h2 class="mb-1">Leave History</h2>
		<p class="text-muted mb-0">
			View your leave history and submit a new leave request.
		</p>
	</div>

	<!-- Action Bar -->
	<div class="d-flex justify-content-end mb-3">
		<button type="button" id="btnApplyLeave"
				class="btn btn-primary btn-sm">

			<i class="bi bi-plus-circle me-1"></i>
			Apply Leave
		</button>
	</div>

	<div class="card shadow-sm">
		<div class="card-body">
			<div class="table-responsive">
				<table class="table table table-bordered table-hover align-middle" id="tblLeave">
					<thead class="table-light">
						<tr>
							<th>Sr No</th>
							<th>Start Date </th>
							<th>End Date</th>
							<th>Total Day</th>
							<th>Leave Type</th>
							<th>Leave Status</th>
							<th>Reason</th>
							<th>HR Comment</th>
							<th>Attachment</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
<!-- Leave Modal -->
<div class="modal fade"
	 id="leaveModal"
	 tabindex="-1"
	 aria-hidden="true">

	<div class="modal-dialog modal-lg">

		<div class="modal-content">
			@await Html.PartialAsync("_LeaveForm", Model)

		</div>

	</div>

</div>

@section Scripts
{
	<script>
		$(document).ready(function () {

			LoadLeaveHistory();

		});
	</script>
}
