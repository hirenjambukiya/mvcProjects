@model LeaveForm

<form id="frmLeave" enctype="multipart/form-data">

	@Html.AntiForgeryToken()
	<div class="modal-body">
	<input type="hidden" asp-for="LeaveId" />

		<div asp-validation-summary="ModelOnly" class="text-danger"></div>

		<div class="mb-3">
			<label asp-for="LeaveType"></label>

			<select asp-for="LeaveType"
					asp-items="@Model.LeaveTypeist"
					class="form-select">

				<option value="">--Select--</option>

			</select>

			<span asp-validation-for="LeaveType" class="text-danger"></span>

		</div>

		<div class="mb-3">
			<label asp-for="StartDate"></label>

			<input asp-for="StartDate" type="date"
				   class="form-control" />

			<span asp-validation-for="StartDate"
				  class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="EndDate"></label>

			<input asp-for="EndDate" type="date"
				   class="form-control" />

			<span asp-validation-for="EndDate"
				  class="text-danger"></span>
		</div>

		<div class="mb-3">

			<label asp-for="Reason"></label>

			<textarea asp-for="Reason"
					  class="form-control"></textarea>

			<span asp-validation-for="Reason"
				  class="text-danger"></span>

		</div>

		<div class="mb-3">

			<label asp-for="Attchement"></label>

			<input asp-for="Attchement"
				   type="file"
				   class="form-control" />

			<span asp-validation-for="Attchement"
				  class="text-danger"></span>

		</div>

	</div>

	<div class="modal-footer">

		<button type="button"
				class="btn btn-secondary"
				data-bs-dismiss="modal">

			Close

		</button>

		<button type="submit"
				class="btn btn-primary">

			Submit

		</button>

	</div>

</form>

<partial name="_ValidationScriptsPartial" />