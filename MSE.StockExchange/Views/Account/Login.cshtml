@model MSE.StockExchange.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Secure Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Metropolitan Stock Exchange</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="login-bg">

    <div class="container h-100 d-flex justify-content-center align-items-center">
        <div class="col-md-5 col-lg-4">
            <div class="login-card p-5">
                <div class="text-center mb-4 text-white">
                    <div class="mse-logo d-inline-flex mb-3">
                        <span class="m">M</span><span class="s">S</span><span class="e">E</span><div class="arrow"></div>
                    </div>
                    <h5 class="fw-bold tracking-wide mt-2">METROPOLITAN</h5>
                    <div class="text-accent small tracking-widest">STOCK EXCHANGE</div>
                </div>

                <form id="loginForm" asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ClientEncryptedPassword" id="ClientEncryptedPassword" />
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-2 small text-center p-2 border-0" style="background: rgba(25, 135, 84, 0.2); color: #84ffb8;">
                            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold text-center"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control glass-input" placeholder="User ID" autocomplete="username" />
                        <label asp-for="Username" class="text-white-50"><i class="fa-solid fa-user me-2"></i>User ID</label>
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Password" type="password" id="rawPassword" class="form-control glass-input" placeholder="Password" autocomplete="current-password" />
                        <label asp-for="Password" class="text-white-50"><i class="fa-solid fa-lock me-2"></i>Password</label>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between mb-4 small">
                        <div class="form-check text-white-50">
                            <input type="checkbox" class="form-check-input custom-checkbox" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">Remember Me</label>
                        </div>
                        <a href="#" class="text-accent text-decoration-none hover-underline">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-login fw-bold py-2 mb-3">
                        SECURE LOGIN <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
                    </button>
                    
                    <div class="text-center mt-3 text-white-50 small">
                        <i class="fa-solid fa-shield-halved text-accent me-1"></i> End-to-End Client Encryption Active
                    </div>
                    
                    <div class="text-center mt-3 text-white-50 small">
                        <a asp-action="Register" class="text-accent text-decoration-none hover-underline">Don't have an account? Register here.</a>
                    </div>
                </form>
            </div>
            
            <div class="text-center mt-4 text-white-50 small">
                 &copy; @DateTime.Now.Year - Metropolitan Stock Exchange. All rights reserved.
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script>
        document.getElementById('loginForm').addEventListener('submit', function (e) {
            var rawPassInput = document.getElementById('rawPassword');
            var encryptedPassInput = document.getElementById('ClientEncryptedPassword');
            
            if (rawPassInput.value) {
                // Client side SHA-256 Hashing before sending to server
                // This protects the plaintext password entering the wire
                var hash = CryptoJS.SHA256(rawPassInput.value).toString();
                encryptedPassInput.value = hash;
                
                // Clear the raw password field so it isn't sent in POST body explicitly
                // Note: to prevent validation errors if it's required, we set a dummy value or the hash itself
                rawPassInput.value = hash.substring(0,8); 
            }
        });
    </script>
</body>
</html>
