@model MSE.StockExchange.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Metropolitan Stock Exchange</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="split-layout">
        <!-- Left Pane: Branding -->
        <div class="split-left">
            <div class="split-left-content">
                <div class="mse-logo-box">
                    <img src="~/images/mse-logo.png" alt="MSE Logo" />
                </div>
                <div>
                    <span class="mse-badge"><i class="fa-solid fa-circle text-success me-2" style="font-size: 8px;"></i>SEBI REGULATED EXCHANGE</span>
                    <h1>India's National<br />Stock Exchange<br />Platform</h1>
                    <p class="lead mt-4">Secure access to live markets, listed securities, derivatives and real-time trading infrastructure.</p>
                </div>
            </div>
            
            <div class="stats-container mt-auto">
                <div class="stat-item">
                    <h3>2,400+</h3>
                    <p>LISTED SECURITIES</p>
                </div>
                <div class="stat-item">
                    <h3>46,074</h3>
                    <p>SX40 INDEX</p>
                </div>
                <div class="stat-item">
                    <h3>99.99%</h3>
                    <p>UPTIME</p>
                </div>
            </div>
        </div>

        <!-- Right Pane: Form -->
        <div class="split-right">
            <div class="form-container">
                <h2>Reset Password</h2>
                <p class="subtitle">Enter the OTP sent to your email and select a new password.</p>

                <form id="resetForm" asp-controller="Account" asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Identifier" />
                    <input type="hidden" asp-for="NewClientEncryptedPassword" id="NewClientEncryptedPassword" />
                    <input type="hidden" asp-for="ConfirmClientEncryptedPassword" id="ConfirmClientEncryptedPassword" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold text-center"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Otp" class="form-control text-center fw-bold fs-4 tracking-widest" placeholder="123456" autocomplete="one-time-code" maxlength="6" style="letter-spacing: 0.5em;" />
                        <label asp-for="Otp" class="text-muted text-center w-100">Enter OTP</label>
                        <span asp-validation-for="Otp" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input type="password" id="rawPassword" class="form-control" placeholder="New Password" autocomplete="new-password" />
                        <label class="text-muted"><i class="fa-solid fa-lock me-2"></i>New Password</label>
                        <span class="text-danger small mt-1 d-none" id="rawPassError">Please enter a password</span>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input type="password" id="rawConfirmPassword" class="form-control" placeholder="Confirm Password" autocomplete="new-password" />
                        <label class="text-muted"><i class="fa-solid fa-lock me-2"></i>Confirm Password</label>
                        <span class="text-danger small mt-1 d-none" id="rawConfirmError">Passwords do not match</span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-login fw-bold py-2 mb-3">
                        Update Password
                    </button>
                    
                    <div class="security-alert">
                        <i class="fa-solid fa-shield-halved text-success me-2"></i> Protected by 256-bit TLS encryption and 2FA verification.
                    </div>
                </form>

                <div class="text-center mt-5 text-muted" style="font-size: 0.7rem;">
                    &copy; @DateTime.Now.Year Metropolitan Stock Exchange of India Ltd.<br/>
                    Regulated by SEBI - Member of WFE
                </div>
            </div>
        </div>
    </div>

    <!-- CryptoJS for Client-Side Hashing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script>
        document.getElementById('resetForm').addEventListener('submit', function (e) {
            var rawPassInput = document.getElementById('rawPassword');
            var rawConfirmInput = document.getElementById('rawConfirmPassword');
            var encryptedPassInput = document.getElementById('NewClientEncryptedPassword');
            var encryptedConfirmInput = document.getElementById('ConfirmClientEncryptedPassword');
            var errorSpan = document.getElementById('rawConfirmError');
            
            if (!rawPassInput.value) {
                e.preventDefault();
                document.getElementById('rawPassError').classList.remove('d-none');
                return;
            } else {
                document.getElementById('rawPassError').classList.add('d-none');
            }
            
            if (rawPassInput.value !== rawConfirmInput.value) {
                e.preventDefault();
                errorSpan.classList.remove('d-none');
                return;
            } else {
                errorSpan.classList.add('d-none');
            }
            
            if (rawPassInput.value) {
                var hash = CryptoJS.SHA256(rawPassInput.value).toString();
                encryptedPassInput.value = hash;
                encryptedConfirmInput.value = hash;
                
                rawPassInput.value = hash.substring(0,8); 
                rawConfirmInput.value = hash.substring(0,8); 
            }
        });
    </script>
</body>
</html>
