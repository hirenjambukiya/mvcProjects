@model MSE.StockExchange.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Secure Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Metropolitan Stock Exchange</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="split-layout">
        <!-- Left Pane: Branding -->
        <div class="split-left">
            <div class="split-left-content">
                <div class="mse-logo-box">
                    <img src="~/images/mse-logo.png" alt="MSE Logo" />
                </div>
                <div>
                    <span class="mse-badge"><i class="fa-solid fa-circle text-success me-2" style="font-size: 8px;"></i>SEBI REGULATED EXCHANGE</span>
                    <h1>India's National<br />Stock Exchange<br />Platform</h1>
                    <p class="lead mt-4">Secure access to live markets, listed securities, derivatives and real-time trading infrastructure.</p>
                </div>
            </div>
            
            <div class="stats-container mt-auto">
                <div class="stat-item">
                    <h3>2,400+</h3>
                    <p>LISTED SECURITIES</p>
                </div>
                <div class="stat-item">
                    <h3>46,074</h3>
                    <p>SX40 INDEX</p>
                </div>
                <div class="stat-item">
                    <h3>99.99%</h3>
                    <p>UPTIME</p>
                </div>
            </div>
        </div>

        <!-- Right Pane: Form -->
        <div class="split-right">
            <div class="form-container">
                <h2>Create an account</h2>
                <p class="subtitle">Enter your details to register for the trading portal.</p>

                <form id="registerForm" asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ClientEncryptedPassword" id="ClientEncryptedPassword" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold text-center"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control" placeholder="User ID" />
                        <label asp-for="Username"><i class="fa-regular fa-user me-2"></i>User ID</label>
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="Email Address" type="email" />
                        <label asp-for="Email"><i class="fa-regular fa-envelope me-2"></i>Email Address</label>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <select asp-for="Role" class="form-select">
                            <option value="">-- Select Role --</option>
                            <option value="Company">Company</option>
                            <option value="Maker">Maker</option>
                            <option value="Checker">Checker</option>
                            <option value="HOD">HOD</option>
                        </select>
                        <label asp-for="Role"><i class="fa-solid fa-users-gear me-2"></i>System Role</label>
                        <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" id="rawPassword" class="form-control" placeholder="Password" />
                        <label asp-for="Password"><i class="fa-solid fa-lock me-2"></i>Password</label>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" type="password" id="rawConfirmPassword" class="form-control" placeholder="Confirm Password" />
                        <label asp-for="ConfirmPassword"><i class="fa-solid fa-check-double me-2"></i>Confirm Password</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-login fw-bold py-2 mb-3">
                        Create Account
                    </button>
                    
                    <div class="security-alert">
                        <i class="fa-solid fa-shield-halved text-success me-2"></i> Protected by 256-bit TLS encryption and 2FA verification.
                    </div>
                    
                    <div class="text-center mt-4 text-muted small">
                        Already have an account? <a asp-controller="Account" asp-action="Login" class="text-primary text-decoration-none hover-underline fw-semibold" style="color: #004d80 !important;">Sign In</a>
                    </div>
                </form>

                <div class="text-center mt-5 text-muted" style="font-size: 0.7rem;">
                    &copy; @DateTime.Now.Year Metropolitan Stock Exchange of India Ltd.<br/>
                    Regulated by SEBI - Member of WFE
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script>
        document.getElementById('registerForm').addEventListener('submit', function (e) {
            var rawPassInput = document.getElementById('rawPassword');
            var rawConfirmPassInput = document.getElementById('rawConfirmPassword');
            var encryptedPassInput = document.getElementById('ClientEncryptedPassword');
            
            if (rawPassInput.value) {
                var hash = CryptoJS.SHA256(rawPassInput.value).toString();
                encryptedPassInput.value = hash;
                
                if(rawPassInput.value === rawConfirmPassInput.value) {
                    rawPassInput.value = hash.substring(0,8); 
                    rawConfirmPassInput.value = hash.substring(0,8);
                } else {
                    rawConfirmPassInput.value = "mismatch";
                    rawPassInput.value = hash.substring(0,8);
                }
            }
        });
    </script>
</body>
</html>
