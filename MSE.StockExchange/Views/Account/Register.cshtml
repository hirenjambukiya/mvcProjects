@model MSE.StockExchange.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Secure Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Metropolitan Stock Exchange</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="login-bg">

    <div class="container h-100 d-flex justify-content-center align-items-center my-5">
        <div class="col-md-6 col-lg-5">
            <div class="login-card p-5">
                <div class="text-center mb-4 text-white">
                    <div class="mse-logo d-inline-flex mb-3">
                        <span class="m">M</span><span class="s">S</span><span class="e">E</span><div class="arrow"></div>
                    </div>
                    <h5 class="fw-bold tracking-wide mt-2">METROPOLITAN</h5>
                    <div class="text-accent small tracking-widest">STOCK EXCHANGE</div>
                    <div class="mt-2 text-white-50">Create a Secure Account</div>
                </div>

                <form id="registerForm" asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ClientEncryptedPassword" id="ClientEncryptedPassword" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold text-center"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control glass-input" placeholder="User ID" />
                        <label asp-for="Username" class="text-white-50"><i class="fa-solid fa-user me-2"></i>User ID</label>
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control glass-input" placeholder="Email Address" type="email" />
                        <label asp-for="Email" class="text-white-50"><i class="fa-solid fa-envelope me-2"></i>Email Address</label>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <select asp-for="Role" class="form-select glass-input">
                            <option value="">-- Select Role --</option>
                            <option value="Company">Company</option>
                            <option value="Maker">Maker</option>
                            <option value="Checker">Checker</option>
                            <option value="HOD">HOD</option>
                        </select>
                        <label asp-for="Role" class="text-white-50"><i class="fa-solid fa-users-gear me-2"></i>System Role</label>
                        <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" id="rawPassword" class="form-control glass-input" placeholder="Password" />
                        <label asp-for="Password" class="text-white-50"><i class="fa-solid fa-lock me-2"></i>Password</label>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" type="password" id="rawConfirmPassword" class="form-control glass-input" placeholder="Confirm Password" />
                        <label asp-for="ConfirmPassword" class="text-white-50"><i class="fa-solid fa-check-double me-2"></i>Confirm Password</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-login fw-bold py-2 mb-3">
                        REGISTER <i class="fa-solid fa-user-plus ms-2"></i>
                    </button>
                    
                    <div class="text-center mt-3 text-white-50 small">
                        <a asp-controller="Account" asp-action="Login" class="text-accent text-decoration-none hover-underline">Already have an account? Login here.</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script>
        document.getElementById('registerForm').addEventListener('submit', function (e) {
            var rawPassInput = document.getElementById('rawPassword');
            var rawConfirmPassInput = document.getElementById('rawConfirmPassword');
            var encryptedPassInput = document.getElementById('ClientEncryptedPassword');
            
            if (rawPassInput.value) {
                // Client side SHA-256 Hashing before sending to server
                var hash = CryptoJS.SHA256(rawPassInput.value).toString();
                encryptedPassInput.value = hash;
                
                // Clear the raw password fields so they aren't sent in POST body explicitly
                if(rawPassInput.value === rawConfirmPassInput.value) {
                    rawPassInput.value = hash.substring(0,8); 
                    rawConfirmPassInput.value = hash.substring(0,8);
                } else {
                    // Let the server-side validation catch mismatch or we can stop submit
                    // For demonstration, we simply apply the same string.
                    rawConfirmPassInput.value = "mismatch";
                    rawPassInput.value = hash.substring(0,8);
                }
            }
        });
    </script>
</body>
</html>
