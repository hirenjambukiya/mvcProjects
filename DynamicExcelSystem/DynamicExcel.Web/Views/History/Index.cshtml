@model IEnumerable<DynamicExcel.Core.Entities.ImportHistory>

@{
    ViewData["Title"] = "Import History";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">@ViewData["Title"]</h1>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-striped" id="historyTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>File Name</th>
                        <th>Target DB</th>
                        <th>Sheets</th>
                        <th>Records</th>
                        <th>Time (s)</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-sort="@item.ImportDate.ToString("yyyyMMddHHmmss")">
                                @item.ImportDate.ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td><strong>@item.FileName</strong></td>
                            <td>@item.ConnectionName</td>
                            <td>@item.TotalSheets</td>
                            <td>@item.TotalRecords.ToString("N0")</td>
                            <td>@item.ExecutionTimeSeconds.ToString("0.00")</td>
                            <td>
                                @if (item.Success)
                                {
                                    <span class="badge bg-success"><i data-feather="check"></i> Success</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i data-feather="x"></i> Failed</span>
                                    @if (!string.IsNullOrEmpty(item.ErrorMessage))
                                    {
                                        <button class="btn btn-sm btn-link text-danger p-0 ms-1 btn-error-detail" data-error="@item.ErrorMessage">
                                            <i data-feather="info" style="width:14px;"></i>
                                        </button>
                                    }
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger btn-delete" data-id="@item.Id" title="Delete Log">
                                    <i data-feather="trash-2" style="width:14px;"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#historyTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 25
            });

            $('.btn-error-detail').click(function() {
                var errorMsg = $(this).data('error');
                Swal.fire({
                    title: 'Error Details',
                    text: errorMsg,
                    icon: 'error'
                });
            });

            $('.btn-delete').click(function() {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Delete", "History")', { id: id }, function(res) {
                            if(res.success) {
                                location.reload();
                            }
                        }).fail(function() {
                            Swal.fire('Error', 'Failed to delete record.', 'error');
                        });
                    }
                });
            });
        });
    </script>
}
